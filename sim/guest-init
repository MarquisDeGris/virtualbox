#!/bin/busybox sh
# Init of the test guest of the simulation, see run.sh.
#
# The guest is a Linux kernel with this script and busybox in its initramfs.
# It tells on the serial port what it sees of an NVMe drive which is passed
# through to it: when the drive is there it reads from it and writes to it,
# and it says when the drive comes and goes.  Lines of this script start with
# "GUEST: ".  The kernel may be told to keep quiet on the serial port, as
# every character there is costly where virtualization is nested, so the
# kernel messages the checks go by are passed on from here ("GUEST: k: ").

bb=/bin/busybox
$bb mkdir -p /proc /sys /dev /tmp
$bb mount -t proc proc /proc
$bb mount -t sysfs sys /sys
$bb mount -t devtmpfs dev /dev
# The initramfs has no /dev/console, so the kernel may have started this
# without one.
exec < /dev/console > /dev/console 2>&1
$bb --install -s /bin
export PATH=/bin

say() { echo "GUEST: $*"; }

# Passes on the kernel messages about PCI hot-plug and the drive which have
# come since the last call.
kseen=0
kmsg()
{
    kall=$(dmesg | wc -l)
    if [ "$kall" -gt "$kseen" ]; then
        dmesg | sed -n "$((kseen + 1)),${kall}p" | grep -E '_OSC|PNP0A0|pciehp|nvme|AER|DPC|Timeout|nobody cared|Disabling IRQ' \
            | cut -c1-200 | while read -r l; do say "k: $l"; done
        kseen=$kall
    fi
}

say "UP $(uname -r)"

for m in $(cat /modules.list 2> /dev/null); do
    insmod "/modules/$m" || say "insmod $m failed"
done

for d in /sys/bus/pci/devices/*; do
    drv=none
    [ -e "$d/driver" ] && drv=$(basename "$(readlink "$d/driver")")
    say "pci: ${d##*/} $(cat "$d/vendor"):$(cat "$d/device") class $(cat "$d/class") driver $drv"
done
kmsg
say "READY"

# A network adapter, where the VM has one (the phase "nat" of the simulation):
# an address from the DHCP server on the other side, a ping to the gateway it
# names, and a file fetched from there, whose checksum is told.  With NAT of
# VirtualBox the gateway is the machine the VM runs on.
net_try()
{
    [ -e /sys/class/net/eth0 ] || return 0
    ip link set eth0 up
    cat > /tmp/dhcp.sh << 'EOF'
#!/bin/busybox sh
case "$1" in
    bound|renew)
        /bin/busybox ip addr add "$ip/${mask:-24}" dev "$interface"
        [ -n "$router" ] && /bin/busybox ip route add default via "${router%% *}"
        echo "$ip ${router%% *}" > /tmp/dhcp.out
        ;;
esac
EOF
    chmod 755 /tmp/dhcp.sh
    if ! udhcpc -i eth0 -n -q -t 8 -T 2 -s /tmp/dhcp.sh > /tmp/dhcp.log 2>&1 || [ ! -s /tmp/dhcp.out ]; then
        say "NET dhcp failed: $(tail -n 2 /tmp/dhcp.log | tr '\n' ' ' | cut -c1-120)"
        return 0
    fi
    read -r nip ngw < /tmp/dhcp.out
    say "NET dhcp $nip gateway ${ngw:-none}"
    [ -n "$ngw" ] || return 0
    if ping -c 3 -W 3 "$ngw" > /tmp/ping.log 2>&1; then
        say "NET ping ok"
    else
        say "NET ping failed: $(tail -n 2 /tmp/ping.log | tr '\n' ' ' | cut -c1-120)"
    fi
    if wget -q -T 20 -O /tmp/net.bin "http://$ngw:8099/sim.bin" 2> /tmp/wget.log; then
        say "NET http md5=$(md5sum < /tmp/net.bin | cut -d' ' -f1) bytes=$(wc -c < /tmp/net.bin)"
    else
        say "NET http failed: $(tail -n 2 /tmp/wget.log | tr '\n' ' ' | cut -c1-120)"
    fi
    rm -f /tmp/net.bin
}
net_try

# The drive: whatever has the class of an NVMe controller.
finddev()
{
    for d in /sys/bus/pci/devices/*; do
        if [ "$(cat "$d/class" 2> /dev/null)" = 0x010802 ]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# The drive of a controller, given the controller as a PCI device.  A device
# with two functions has two controllers, and which of them the kernel calls
# nvme0 is not fixed.
blk() # <PCI device in sysfs>
{
    for c in "$1"/nvme/nvme*; do
        if [ -b "/dev/${c##*/}n1" ]; then
            echo "/dev/${c##*/}n1"
            return 0
        fi
    done
    # A kernel which does not show the controller there: any drive, as long
    # as there is one controller only.
    [ -d "$1/nvme" ] && return 1
    nc=0
    for c in /sys/bus/pci/devices/*; do
        [ "$(cat "$c/class" 2> /dev/null)" = 0x010802 ] && nc=$((nc + 1))
    done
    [ "$nc" = 1 ] || return 1
    for b in /dev/nvme*n1; do
        if [ -b "$b" ]; then
            echo "$b"
            return 0
        fi
    done
    return 1
}

# The second function of the device, where it has one which is an NVMe
# controller too: a device of the host with two functions (run.sh).
second() # <PCI device in sysfs, the first function>
{
    s="${1%.*}.1"
    if [ "$s" != "$1" ] && [ "$(cat "$s/class" 2> /dev/null)" = 0x010802 ]; then
        echo "$s"
        return 0
    fi
    return 1
}

# Reads the first 8 MiB from the drive itself, not from the page cache.
readsum()
{
    echo 3 > /proc/sys/vm/drop_caches
    dd if="$1" bs=1M count=8 2> /dev/null | md5sum | cut -d' ' -f1
}

# Reads from the drive and writes to it, and tells of both.
use_drive() # <block device>
{
    say "READ $n md5=$(readsum "$1")"
    if echo "written by the guest, round $n" | dd of="$1" bs=1M seek=12 conv=fsync 2> /dev/null; then
        say "WROTE $n"
    else
        say "WRITE-FAILED $n"
    fi
    say "IRQ $n $(grep -c nvme /proc/interrupts) lines: $(grep nvme /proc/interrupts | head -n 2 | tr -s ' ' | cut -c1-120 | tr '\n' '|')"
}

# The same for the drive of the second function, with lines of its own.  What
# is written there is not what is written to the first drive.
use_second() # <PCI device in sysfs, the second function>
{
    i=0
    while [ "$i" -lt 60 ] && ! blk "$1" > /dev/null; do
        sleep 1
        i=$((i + 1))
    done
    if b2=$(blk "$1"); then
        say "READ2 $n md5=$(readsum "$b2")"
        if echo "written by the guest to the second drive, round $n" | dd of="$b2" bs=1M seek=12 conv=fsync 2> /dev/null; then
            say "WROTE2 $n"
        else
            say "WRITE2-FAILED $n"
        fi
    else
        say "NODRIVE2 $n ${1##*/}"
    fi
}

# The controller is there and its drive is not: what the kernel has to say
# about that, whatever it is, and which of its tasks wait for what.
nodrive_diag()
{
    say "D: nvme in /dev and /sys: $(ls /dev/nvme* /sys/class/nvme/ 2>&1 | tr '\n' ' ' | cut -c1-200)"
    for s in /sys/class/nvme/nvme*/state; do
        [ -e "$s" ] && say "D: $s $(cat "$s" 2>&1)"
    done
    say "D: interrupts: $(grep -c nvme /proc/interrupts) lines: $(grep nvme /proc/interrupts | head -n 3 | tr -s ' ' | cut -c1-120 | tr '\n' '|')"
    echo w > /proc/sysrq-trigger 2> /dev/null
    dmesg | tail -n 45 | cut -c1-160 | while read -r l; do say "D: $l"; done
    kseen=$(dmesg | wc -l)
}

n=0
rr=0
tick=0
late=
state=absent
while :; do
    if d=$(finddev); then
        if [ "$state" = absent ]; then
            state=present
            late=
            n=$((n + 1))
            say "PRESENT $n ${d##*/} $(cat "$d/vendor"):$(cat "$d/device")"
            i=0
            while [ "$i" -lt 60 ] && ! blk "$d" > /dev/null; do
                sleep 1
                i=$((i + 1))
            done
            kmsg
            if b=$(blk "$d"); then
                use_drive "$b"
                if d2=$(second "$d"); then
                    say "PRESENT2 $n ${d2##*/} $(cat "$d2/vendor"):$(cat "$d2/device")"
                    use_second "$d2"
                    kmsg
                fi
            else
                # Not giving up: where every exit from this guest is slow the
                # drive has taken longer than this to show (run 231), and the
                # loop below goes on looking for it.
                say "NODRIVE $n"
                nodrive_diag
                late=$tick
            fi
        elif [ -n "$late" ]; then
            if b=$(blk "$d"); then
                say "LATE $n the drive is there $((tick - late)) rounds after it was given up on"
                kmsg
                late=
                use_drive "$b"
                if d2=$(second "$d"); then
                    say "PRESENT2 $n ${d2##*/} $(cat "$d2/vendor"):$(cat "$d2/device")"
                    use_second "$d2"
                fi
            fi
        elif [ $((tick % 10)) = 0 ] && b=$(blk "$d"); then
            rr=$((rr + 1))
            say "REREAD $rr md5=$(readsum "$b")"
            if d2=$(second "$d") && b2=$(blk "$d2"); then
                say "REREAD2 $rr md5=$(readsum "$b2")"
            fi
        fi
    elif [ "$state" = present ]; then
        state=absent
        late=
        kmsg
        say "GONE $n"
    fi
    if [ $((tick % 10)) = 0 ]; then
        kmsg
        # With the number of interrupts the ACPI hardware has raised so far:
        # the power button is one of them.  And with the time the kernel has
        # been up, which tells how long a round of this loop takes.
        say "ALIVE $tick sci=$(grep ' acpi$' /proc/interrupts | awk '{ print $2 }') up=$(cut -d' ' -f1 /proc/uptime)"
    fi
    tick=$((tick + 1))
    sleep 1
done
