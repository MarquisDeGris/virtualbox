#!/bin/busybox sh
# Init of the small Linux guest of hw/linux/test-b.sh: a kernel with this
# script, busybox and the drivers of the device in its initramfs.  It tells on
# the serial port what it makes of the device which was passed through to it:
# the PCI devices behind bridges, which driver has them, their memory and
# their ROM, what the kernel says while the driver takes the device, the
# interrupts, and for a graphics card the connectors and whether a monitor is
# on one.  Lines of this script start
# with "HW: ".

bb=/bin/busybox
$bb mkdir -p /proc /sys /dev /tmp /lib/firmware
$bb mount -t proc proc /proc
$bb mount -t sysfs sys /sys
$bb mount -t devtmpfs dev /dev
exec < /dev/console > /dev/console 2>&1
$bb --install -s /bin
export PATH=/bin

say() { echo "HW: $*"; }

say "UP $(uname -r)"

# The legacy VGA ranges, where the VM was given those of the card
# ("hwvga=1" on the command line of the kernel): before any driver has the
# card, one register read through the I/O ports and the first two bytes of the
# text memory.  With "hwvgawrite=1" registers of the sequencer are also set,
# so that the memory at 0xa0000 takes bytes as they are written, and bytes
# are written to both ends of that memory and read back: only for a card
# nobody looks at, which the simulation has.
hex1() # what comes in as hexadecimal digits, with whichever tool this busybox has for it
{
    if echo | od -A n -t x1 > /dev/null 2>&1; then
        od -A n -t x1 | tr -d ' \n'
    elif echo | hexdump -v -e '1/1 "%02x"' > /dev/null 2>&1; then
        hexdump -v -e '1/1 "%02x"'
    else
        xxd -p | tr -d '\n'
    fi
}
port_in() { dd if=/dev/port bs=1 skip="$(($1))" count=1 2> /dev/null | hex1; }
port_out() { printf "\\$(printf '%03o' "$(($2))")" | dd of=/dev/port bs=1 seek="$(($1))" count=1 conv=notrunc 2> /dev/null; }
vgaports=no
if grep -q -w 'hwvga=1' /proc/cmdline; then
    vgaports=yes
    line="VGA misc=$(port_in 0x3cc) text=$(devmem 0xb8000 16 2> /dev/null || echo refused)"
    if grep -q -w 'hwvgawrite=1' /proc/cmdline; then
        # Sequencer: register 2, all four planes take what is written;
        # register 4, a byte of memory for each address.  Graphics
        # controller: register 6, the memory is at 0xa0000 to 0xbffff.
        port_out 0x3c4 2
        port_out 0x3c5 0x0f
        line="$line seq2=$(port_in 0x3c4):$(port_in 0x3c5)"
        port_out 0x3c4 4
        port_out 0x3c5 0x0e
        line="$line seq4=$(port_in 0x3c4):$(port_in 0x3c5)"
        port_out 0x3ce 6
        port_out 0x3cf 0x01
        line="$line gfx6=$(port_in 0x3ce):$(port_in 0x3cf)"
        devmem 0xa0000 32 0x48574241 2> /dev/null || line="$line write-first=failed"
        devmem 0xbfffc 32 0x52454e44 2> /dev/null || line="$line write-last=failed"
        line="$line first=$(devmem 0xa0000 32 2> /dev/null || echo refused) last=$(devmem 0xbfffc 32 2> /dev/null || echo refused)"
    fi
    say "$line"
fi

# The drivers, in the order they were put in.  One which is built into the
# kernel is not in the list and has its devices already.
for m in $(cat /modules.list 2> /dev/null); do
    insmod "/modules/$m" 2> /tmp/insmod.err || say "insmod $m: $(head -n 1 /tmp/insmod.err | cut -c1-120)"
done

# A driver of a graphics card takes a moment, more when it has to load
# firmware: wait until the devices behind bridges have drivers, at most a
# minute, and then a little for what follows from that.
i=0
while [ "$i" -lt 60 ]; do
    left=0
    for d in /sys/bus/pci/devices/*; do
        case "${d##*/}" in 0000:00:*) continue ;; esac
        [ -e "$d/driver" ] || left=1
    done
    [ "$left" = 0 ] && break
    sleep 1
    i=$((i + 1))
done
sleep 5

for d in /sys/bus/pci/devices/*; do
    case "${d##*/}" in 0000:00:*) continue ;; esac
    drv=none
    [ -e "$d/driver" ] && drv=$(basename "$(readlink "$d/driver")")
    say "PCI ${d##*/} $(cat "$d/vendor" | sed 's/^0x//'):$(cat "$d/device" | sed 's/^0x//') class $(cat "$d/class") driver $drv irq $(cat "$d/irq" 2> /dev/null) msi $(ls "$d/msi_irqs" 2> /dev/null | wc -l)"
done

# The memory of the devices behind bridges, BAR by BAR: where the guest has it
# and how large it is, and for one of a megabyte or more the first and the
# last four bytes of it, read through /dev/mem: a device with gigabytes of
# memory has to be reachable to its end.  A BAR a driver has is left alone,
# the kernel does not let it be read this way, and the driver working is the
# better news.  With "hwbarwrite=<vendor>:<device>" on the command line of the
# kernel the same two places of such a device are written to first: only for
# a device whose memory is nothing but memory, which the simulation has.
wr=$(sed -n 's/^.*hwbarwrite=\([0-9a-f:]*\).*$/\1/p' /proc/cmdline)
for d in /sys/bus/pci/devices/*; do
    case "${d##*/}" in 0000:00:*) continue ;; esac
    ids="$(cat "$d/vendor" | sed 's/^0x//'):$(cat "$d/device" | sed 's/^0x//')"
    n=0
    while read -r start end flags; do
        bar=$n
        n=$((n + 1))
        [ "$bar" -le 5 ] || break
        [ "$((start))" != 0 ] || continue
        # Memory, not I/O ports (IORESOURCE_MEM).
        [ "$(( flags & 0x200 ))" != 0 ] || continue
        size=$(( end - start + 1 ))
        line="BAR ${d##*/} $bar at=$start size=$size"
        if [ "$size" -lt 1048576 ]; then
            say "$line"
            continue
        fi
        if [ -e "$d/driver" ]; then
            say "$line first=busy last=busy"
            continue
        fi
        last=$(printf '0x%x' $(( end - 3 )))
        if [ -n "$wr" ] && [ "$wr" = "$ids" ]; then
            devmem "$start" 32 0x48574241 2> /dev/null || line="$line write-first=failed"
            devmem "$last" 32 0x52454e44 2> /dev/null || line="$line write-last=failed"
        fi
        f=$(devmem "$start" 32 2> /dev/null) || f=refused
        l=$(devmem "$last" 32 2> /dev/null) || l=refused
        say "$line first=$f last=$l"
    done < "$d/resource"
done

# The ROM of the devices behind bridges, which a graphics card has its
# firmware in and which its driver reads: how many bytes of it the guest
# reads, and a checksum of them.
for d in /sys/bus/pci/devices/*; do
    case "${d##*/}" in 0000:00:*) continue ;; esac
    if [ ! -e "$d/rom" ]; then
        say "ROM ${d##*/} none"
        continue
    fi
    if echo 1 > "$d/rom" 2> /dev/null && cat "$d/rom" > /tmp/rom 2> /dev/null && [ -s /tmp/rom ]; then
        say "ROM ${d##*/} size=$(wc -c < /tmp/rom) md5=$(md5sum < /tmp/rom | cut -c1-32)"
    else
        say "ROM ${d##*/} unreadable"
    fi
    echo 0 > "$d/rom" 2> /dev/null
    rm -f /tmp/rom
done

# The interrupts which are not the ones every VM has.
grep -E '^ *[0-9]+:' /proc/interrupts \
    | grep -v -E 'timer|i8042|rtc0|acpi|ahci|cascade|ttyS|ehci|xhci|virtio|PCIe|pciehp|aerdrv|dmar' \
    | tr -s ' ' | cut -c1-150 | while read -r l; do say "IRQ $l"; done

# A graphics card: its connectors, and what is on them.
for c in /sys/class/drm/card*-*; do
    [ -e "$c/status" ] || continue
    edid=0
    [ -e "$c/edid" ] && edid=$(wc -c < "$c/edid")
    # Whose connector it is: the PCI device of its card, or what else the card
    # is, which for the graphics adapter every VM has is no PCI device here.
    card=${c##*/}
    card=${card%%-*}
    dev=$(basename "$(readlink "/sys/class/drm/$card/device" 2> /dev/null)" 2> /dev/null)
    say "DRM ${c##*/} dev=${dev:-none} $(cat "$c/status") edid=$edid modes=$(wc -l < "$c/modes" 2> /dev/null)"
done
[ -e /sys/class/drm/card0 ] || say "DRM none"
# Sound cards, as ALSA has them.
if [ -e /proc/asound/cards ]; then
    grep -E '^ *[0-9]+ ' /proc/asound/cards | tr -s ' ' | cut -c1-120 | while read -r l; do say "SOUND $l"; done
fi

# What the kernel said meanwhile about the devices and their drivers, and
# anything which sounds like trouble.  It is taken out of the buffer of the
# kernel, so that what comes later is told once.
kpat='drm|amdgpu|radeon|nouveau|nvidia|i915|xe |snd_hda|hda[-_]|nvme|firmware|vgaarb|BAR [0-9]|pciehp|AER|DPC|nobody cared|Disabling IRQ|timed? ?out|fail|error|BUG:|Oops|WARNING:|Call Trace'
ksay() # <at most so many lines>
{
    grep -i -E "$kpat" | sed -e 's/^\[ *[0-9.]*\] //' -e 's/^\(.\{0,180\}\).*/\1/' | tail -n "$1" | while read -r l; do say "k: $l"; done
}
dmesg -c | ksay 80

say "READY"

# From here on, once a second: which devices are behind bridges and which
# driver has each, how many connectors the graphics cards among them have and
# on how many of those something is.  It is told whenever it is not what was
# told last ("NOW ..."), and once more with every sign of life ("STILL ..."),
# as a line of the serial port can get lost in what the kernel writes there.
# A device which leaves the VM and comes back shows here, and so does what
# the kernel says about it; hw/linux/test-c.sh looks at both.
there()
{
    local s= d drv c card dev nc=0 non=0
    for d in /sys/bus/pci/devices/*; do
        [ -e "$d/vendor" ] || continue
        case "${d##*/}" in 0000:00:*) continue ;; esac
        drv=none
        [ -e "$d/driver" ] && drv=$(basename "$(readlink "$d/driver")")
        s="$s ${d##*/}=${drv:-none}"
    done
    for c in /sys/class/drm/card*-*; do
        [ -e "$c/status" ] || continue
        card=${c##*/}
        card=${card%%-*}
        dev=$(basename "$(readlink "/sys/class/drm/$card/device" 2> /dev/null)" 2> /dev/null)
        # Only the cards which are PCI devices behind a bridge.
        case "$dev" in
            0000:00:*) continue ;;
            [0-9a-f][0-9a-f][0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:*) ;;
            *) continue ;;
        esac
        nc=$((nc + 1))
        [ "$(cat "$c/status" 2> /dev/null)" = connected ] && non=$((non + 1))
    done
    echo "${s:- nothing}; connectors $nc, connected $non"
}
last=
n=0
t=0
while :; do
    dmesg -c | ksay 40
    cur=$(there)
    if [ "$cur" != "$last" ]; then
        say "NOW$cur"
        last=$cur
    fi
    sleep 1
    t=$((t + 1))
    if [ "$t" -ge 5 ]; then
        t=0
        n=$((n + 1))
        # With the legacy VGA ranges: what the register of the card reads as
        # through the ports now.  Nothing answers there while the card is out
        # of the VM, which reads as ff; hw/linux/test-c.sh looks at it.
        [ "$vgaports" = yes ] && say "VGAPORT misc=$(port_in 0x3cc)"
        say "ALIVE $n"
        say "STILL$cur"
    fi
done
